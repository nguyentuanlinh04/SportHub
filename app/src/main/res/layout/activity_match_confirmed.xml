<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainMatchConfirmed"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    tools:context=".MatchConfirmedActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="24dp">

        <!-- Top Header Bar (Back & Title) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back Button"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Kèo đã chốt"
                android:textColor="@color/text_title"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Kèo đã chốt" />
        </LinearLayout>

        <!-- Announcement Banner Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_checkbox_checked"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvBannerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_skill_badge_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Đã chốt kèo"
                android:textColor="#0A6A3A"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Đã chốt kèo" />

            <TextView
                android:id="@+id/tvBannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Hai đội đã sẵn sàng, hẹn gặp ngày 11/11!"
                android:textColor="@color/text_title"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Hai đội đã sẵn sàng, hẹn gặp ngày 11/11!" />
        </LinearLayout>

        <!-- Versus Teams Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_pitch"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Team 1: Minh FC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_team_avatar_green"
                    android:gravity="center"
                    android:text="MF"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="MF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMyTeamName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minh FC"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Minh FC" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Đội của bạn · Đội trưởng Minh"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp"
                        tools:text="Đội của bạn · Đội trưởng Minh" />
                </LinearLayout>
            </LinearLayout>

            <!-- VS Divider Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="8dp"
                android:text="VS"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="VS" />

            <!-- Team 2: FC Cầu Giấy United -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOpponentAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_team_avatar_green"
                    android:gravity="center"
                    android:text="FC"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="FC" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOpponentTeamName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FC Cầu Giấy United"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="FC Cầu Giấy United" />

                    <TextView
                        android:id="@+id/tvOpponentCaptain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Đội trưởng: Hoàng Nam"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp"
                        tools:text="Đội trưởng: Hoàng Nam" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Match Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_pitch"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Ngày đá"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Ngày đá" />

                <TextView
                    android:id="@+id/tvConfirmedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="T4, 11/11/2026"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="T4, 11/11/2026" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Thời gian"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Thời gian" />

                <TextView
                    android:id="@+id/tvConfirmedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="19:00–20:00"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="19:00–20:00" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Loại sân"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Loại sân" />

                <TextView
                    android:id="@+id/tvConfirmedPitchType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Sân 7 · 50/50"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Sân 7 · 50/50" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Địa điểm"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Địa điểm" />

                <TextView
                    android:id="@+id/tvConfirmedLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Thắng Long · Sân 7-1"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Thắng Long · Sân 7-1" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Main Action Button 1: Xem trong Lịch đặt -->
        <TextView
            android:id="@+id/btnViewInSchedule"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_action_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Xem trong Lịch đặt"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Xem trong Lịch đặt" />

        <!-- Secondary Action Button 2: Huỷ kèo -->
        <TextView
            android:id="@+id/btnCancelMatch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_cancel_red"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Huỷ kèo"
            android:textColor="#C0392B"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Huỷ kèo" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
