<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rlDistrictContainer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/ivLocationPin"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Location Pin"
            android:src="@drawable/ic_location_pin" />

        <TextView
            android:id="@+id/tvDistrictName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/ivLocationPin"
            android:text="Cầu Giấy"
            android:textColor="@color/text_title"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Cầu Giấy" />

        <!-- Selected Checkmark (Only shown when this district is selected) -->
        <ImageView
            android:id="@+id/ivCheckmark"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="Checkmark"
            android:src="@drawable/ic_checkmark_green" />

    </RelativeLayout>

    <View
        android:id="@+id/vDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="#EAEFE9" />

</LinearLayout>
