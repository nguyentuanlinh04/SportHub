<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminMainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <!-- FRAGMENT CONTAINER -->
    <FrameLayout
        android:id="@+id/adminContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer" />

    <!-- BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- TAB 1: TỔNG QUAN -->
        <LinearLayout
            android:id="@+id/tabDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTabDashboard"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_home" />

            <TextView
                android:id="@+id/tvTabDashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tổng quan"
                android:textColor="#0E9F6E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TAB 2: DUYỆT -->
        <LinearLayout
            android:id="@+id/tabApproval"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTabApproval"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_shield" />

            <TextView
                android:id="@+id/tvTabApproval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Duyệt"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- TAB 3: TÀI KHOẢN -->
        <LinearLayout
            android:id="@+id/tabAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTabAccount"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_users" />

            <TextView
                android:id="@+id/tvTabAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tài khoản"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- TAB 4: CỘNG ĐỒNG -->
        <LinearLayout
            android:id="@+id/tabCommunity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTabCommunity"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_community" />

            <TextView
                android:id="@+id/tvTabCommunity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cộng đồng"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- TAB 5: HỆ THỐNG -->
        <LinearLayout
            android:id="@+id/tabSystem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTabSystem"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_system" />

            <TextView
                android:id="@+id/tvTabSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Hệ thống"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>