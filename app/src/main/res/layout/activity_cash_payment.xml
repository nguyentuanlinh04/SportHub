<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainCashPayment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    tools:context=".CashPaymentActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="24dp">

        <!-- Top Bar Header (Back & Title) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back Button"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Thanh toán tiền mặt"
                android:textColor="@color/text_title"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Thanh toán tiền mặt" />
        </LinearLayout>

        <!-- Circle Cash Icon Container -->
        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_success_circle">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="Cash Icon"
                android:src="@drawable/ic_cash_payment" />
        </FrameLayout>

        <!-- Status Header Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Xác nhận trả sau tiền mặt"
            android:textColor="@color/text_title"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Xác nhận trả sau tiền mặt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Bạn sẽ thanh toán trực tiếp 850.000đ cho nhân viên khi đến sân bóng."
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            tools:text="Bạn sẽ thanh toán trực tiếp 850.000đ cho nhân viên khi đến sân bóng." />

        <!-- Order Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_pitch"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPitchSubPitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cụm sân Thắng Long · Sân 5-A"
                android:textColor="@color/text_title"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Cụm sân Thắng Long · Sân 5-A" />

            <TextView
                android:id="@+id/tvOrderCodeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SH-1109-0187 · Minh"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                tools:text="SH-1109-0187 · Minh" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#EAEFE9" />

            <TextView
                android:id="@+id/tvFullDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thứ 2, 09/11/2026 · 18:00–20:00"
                android:textColor="@color/text_title"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Thứ 2, 09/11/2026 · 18:00–20:00" />
        </LinearLayout>

        <!-- Cash Details Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_pitch"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Số tiền cọc online"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Số tiền cọc online" />

                <TextView
                    android:id="@+id/tvOnlineDepositAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="0đ"
                    android:textColor="@color/primary_green"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="0đ" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Tổng tiền thu tại sân"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Tổng tiền thu tại sân" />

                <TextView
                    android:id="@+id/tvFieldCashAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="850.000đ"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="850.000đ" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Notice Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_checkbox_checked"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lưu ý thanh toán tại sân"
                android:textColor="#0A6A3A"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Lưu ý thanh toán tại sân" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vui lòng có mặt trước giờ đá 15 phút và đưa mã đặt sân SH-1109-0187 cho nhân viên để thanh toán trực tiếp."
                android:textColor="#374151"
                android:textSize="12sp"
                tools:text="Vui lòng có mặt trước giờ đá 15 phút và đưa mã đặt sân SH-1109-0187 cho nhân viên để thanh toán trực tiếp." />
        </LinearLayout>

        <!-- Main Button 1: Xác nhận đặt sân -->
        <TextView
            android:id="@+id/btnConfirmCashBooking"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_action_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Xác nhận đặt sân"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Xác nhận đặt sân" />

        <!-- Secondary Button 2: Đổi phương thức thanh toán -->
        <TextView
            android:id="@+id/btnChangeMethod"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_btn_edit_profile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Đổi phương thức thanh toán"
            android:textColor="@color/primary_green"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Đổi phương thức thanh toán" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
