<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogPinMapTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Ghim vị trí chính xác trên bản đồ"
                android:textColor="@color/owner_text_title"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Định vị tọa độ để khách hàng tìm đường và check-in chính xác"
                android:textColor="@color/owner_text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnClosePinMap"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/owner_text_sub"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#F1F5F9" />

    <!-- Địa chỉ tham chiếu -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Địa chỉ cơ sở"
        android:textColor="@color/owner_text_title"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtPinAddress"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_owner_search_input"
        android:hint="Nhập hoặc xác nhận địa chỉ..."
        android:inputType="textPostalAddress"
        android:paddingHorizontal="12dp"
        android:textColor="@color/owner_text_title"
        android:textColorHint="@color/owner_text_sub"
        android:textSize="13sp" />

    <!-- Interactive Simulated Map Canvas -->
    <FrameLayout
        android:id="@+id/layoutSimulatedMapCanvas"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_map_preview">

        <!-- Grid roads -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#DEEAE0" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:background="#DEEAE0" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#DEEAE0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#DEEAE0" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:background="#DEEAE0" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#DEEAE0" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Pin Marker -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pin_circle"
                android:padding="7dp"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvPinBadgeCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_pinned"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="10.729100° B, 106.731300° Đ"
                android:textColor="#15803D"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Touch Hint Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="#CC1E293B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="📍 Chạm để tinh chỉnh ghim"
            android:textColor="@color/white"
            android:textSize="9sp" />
    </FrameLayout>

    <!-- Fast action buttons: Auto geocode & Current GPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAutoGeocode"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_owner_btn_manage"
            android:text="🎯 Lấy theo địa chỉ"
            android:textAllCaps="false"
            android:textColor="@color/owner_btn_manage_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnCurrentGps"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_owner_btn_manage"
            android:text="🧭 Vị trí hiện tại"
            android:textAllCaps="false"
            android:textColor="@color/owner_btn_manage_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Vĩ độ & Kinh độ Inputs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vĩ độ (Latitude) *"
                android:textColor="@color/owner_text_title"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPinLatitude"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_owner_search_input"
                android:hint="VD: 10.729100"
                android:inputType="numberDecimal|numberSigned"
                android:paddingHorizontal="10dp"
                android:textColor="@color/owner_text_title"
                android:textColorHint="@color/owner_text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kinh độ (Longitude) *"
                android:textColor="@color/owner_text_title"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPinLongitude"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_owner_search_input"
                android:hint="VD: 106.731300"
                android:inputType="numberDecimal|numberSigned"
                android:paddingHorizontal="10dp"
                android:textColor="@color/owner_text_title"
                android:textColorHint="@color/owner_text_sub"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Mở xem trên Google Maps -->
    <Button
        android:id="@+id/btnOpenGoogleMaps"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_owner_search_input"
        android:text="🗺️ Mở kiểm tra trên Google Maps"
        android:textAllCaps="false"
        android:textColor="#2563EB"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <!-- Button Xác nhận ghim -->
    <Button
        android:id="@+id/btnConfirmPinLocation"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_owner_add_btn"
        android:text="Xác nhận ghim vị trí này"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
