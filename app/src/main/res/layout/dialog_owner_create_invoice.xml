<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lập phiếu thu phí sân"
                android:textColor="@color/owner_text_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Thu tiền trực tiếp tại quầy hoặc xuất hóa đơn QR"
                android:textColor="@color/owner_text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseInvoice"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/owner_text_sub"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Chọn cụm sân & sân con -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Cụm sân và sân con"
        android:textColor="@color/owner_text_title"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtInvoicePitch"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="VD: Cụm Thăng Long - Sân 5-A"
        android:paddingHorizontal="12dp"
        android:text="Cụm Thăng Long - Sân 5-A (18:00 - 19:30)"
        android:textColor="@color/owner_text_title"
        android:textSize="13sp" />

    <!-- Tên khách hàng / Đội bóng -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tên khách hàng / Đội bóng"
        android:textColor="@color/owner_text_title"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtInvoiceCustomer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="VD: FC Bán Tải 07"
        android:paddingHorizontal="12dp"
        android:textColor="@color/owner_text_title"
        android:textSize="13sp" />

    <!-- Tiền sân & Tiền dịch vụ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiền thuê sân (đ)"
                android:textColor="@color/owner_text_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtInvoicePitchFee"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="350.000"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:text="350000"
                android:textColor="@color/owner_text_title"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nước / Dịch vụ (đ)"
                android:textColor="@color/owner_text_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtInvoiceServiceFee"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_field"
                android:hint="50.000"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:text="60000"
                android:textColor="@color/owner_text_title"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelInvoice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_owner_btn_manage"
            android:text="Hủy"
            android:textAllCaps="false"
            android:textColor="@color/owner_btn_manage_text"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnSubmitInvoice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.6"
            android:background="@drawable/bg_owner_add_btn"
            android:text="Xác nhận thu tiền"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>
