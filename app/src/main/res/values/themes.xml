<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Sporthubnew" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors (Thống nhất màu xanh SportHub) -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryDark">@color/primary_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/owner_chip_selected_bg</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/owner_bg_screen</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/owner_text_title</item>

        <!-- Status Bar & Navigation Bar đồng nhất -->
        <item name="android:statusBarColor">@color/owner_topbar_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Sporthubnew" parent="Base.Theme.Sporthubnew" />
</resources>