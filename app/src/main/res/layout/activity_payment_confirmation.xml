<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainPaymentConfirmation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    tools:context=".PaymentConfirmationActivity">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="24dp">

            <!-- Top Bar Header (Back & Title) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back Button"
                    android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Xác nhận và thanh toán"
                    android:textColor="@color/text_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Xác nhận và thanh toán" />
            </LinearLayout>

            <!-- Order Summary Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_pitch"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Row (Pitch Thumbnail + Name & Date) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_pitch_field" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPitchSubPitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cụm sân Thắng Long · Sân 5-A"
                            android:textColor="@color/text_title"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Cụm sân Thắng Long · Sân 5-A" />

                        <TextView
                            android:id="@+id/tvDateTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Thứ 2, 09/11 · 18:00 – 20:00"
                            android:textColor="@color/text_sub"
                            android:textSize="13sp"
                            tools:text="Thứ 2, 09/11 · 18:00 – 20:00" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#EAEFE9" />

                <!-- Price Table -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Tiền sân (2 giờ, giờ vàng)"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="Tiền sân (2 giờ, giờ vàng)" />

                    <TextView
                        android:id="@+id/tvPitchFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="700.000đ"
                        android:textColor="@color/text_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="700.000đ" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Áo bib phân đội × 1"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="Áo bib phân đội × 1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="30.000đ"
                        android:textColor="@color/text_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="30.000đ" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Thùng nước giải khát × 1"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="Thùng nước giải khát × 1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="120.000đ"
                        android:textColor="@color/text_title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="120.000đ" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#EAEFE9" />

                <!-- Total Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Tổng cộng"
                        android:textColor="@color/text_title"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Tổng cộng" />

                    <TextView
                        android:id="@+id/tvTotalPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="850.000đ"
                        android:textColor="@color/primary_green"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="850.000đ" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Section: Hình thức thanh toán -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="Hình thức thanh toán"
                android:textColor="@color/text_title"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Hình thức thanh toán" />

            <!-- Option 1: Đặt cọc 30% -->
            <RelativeLayout
                android:id="@+id/llOptionDeposit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_checkbox_checked"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivRadioDeposit"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Radio Deposit"
                    android:src="@drawable/ic_radio_checked" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@id/ivRadioDeposit"
                    android:layout_toStartOf="@id/tvDepositAmount"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đặt cọc 30% qua cổng điện tử"
                        android:textColor="@color/text_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Đặt cọc 30% qua cổng điện tử" />

                    <TextView
                        android:id="@+id/tvRemainingDepositNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Còn lại 595.000đ trả tại sân"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp"
                        tools:text="Còn lại 595.000đ trả tại sân" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDepositAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="255.000đ"
                    android:textColor="@color/primary_green"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="255.000đ" />
            </RelativeLayout>

            <!-- Option 2: Thanh toán toàn phần -->
            <RelativeLayout
                android:id="@+id/llOptionFull"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_checkbox_unchecked"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivRadioFull"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Radio Full"
                    android:src="@drawable/ic_radio_unchecked" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@id/ivRadioFull"
                    android:layout_toStartOf="@id/tvFullAmount"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thanh toán toàn phần"
                        android:textColor="@color/text_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Thanh toán toàn phần" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Ví điện tử, thẻ ngân hàng hoặc QR"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp"
                        tools:text="Ví điện tử, thẻ ngân hàng hoặc QR" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFullAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="850.000đ"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="850.000đ" />
            </RelativeLayout>

            <!-- Option 3: Trả sau bằng tiền mặt -->
            <RelativeLayout
                android:id="@+id/llOptionCash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_checkbox_unchecked"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ivRadioCash"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Radio Cash"
                    android:src="@drawable/ic_radio_unchecked" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:layout_toEndOf="@id/ivRadioCash"
                    android:layout_toStartOf="@id/tvCashAmount"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trả sau bằng tiền mặt"
                        android:textColor="@color/text_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Trả sau bằng tiền mặt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Thanh toán trực tiếp tại sân"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp"
                        tools:text="Thanh toán trực tiếp tại sân" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCashAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="0đ"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="0đ" />
            </RelativeLayout>

            <!-- Cancellation Warning Notice Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_notice_warning"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Info Icon"
                    android:src="@drawable/ic_info_circle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Hủy trước 12 giờ so với giờ đá được hoàn 100% tiền cọc. Hủy muộn hơn sẽ không được hoàn cọc."
                    android:textColor="#8F5300"
                    android:textSize="12sp"
                    tools:text="Hủy trước 12 giờ so với giờ đá được hoàn 100% tiền cọc. Hủy muộn hơn sẽ không được hoàn cọc." />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_action_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Thanh toán cọc 255.000đ"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Thanh toán cọc 255.000đ" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
