<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvReplyCustomerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trả lời Nguyễn Hoàng Khang"
            android:textColor="@color/owner_text_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseReplyReview"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/owner_text_sub"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Review trích dẫn -->
    <TextView
        android:id="@+id/tvReplyOriginalReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="&quot;Mặt cỏ đẹp, sạch. Lưới khung thành góc phải hơi chùng, bóng lọt ra sau.&quot;"
        android:textColor="@color/owner_text_sub"
        android:textSize="12sp"
        android:textStyle="italic" />

    <!-- Label: Nội dung phản hồi chính thức -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Nội dung phản hồi chính thức"
        android:textColor="@color/owner_text_title"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtReplyReviewContent"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_owner_search_input"
        android:gravity="top|start"
        android:padding="12dp"
        android:text="Chào anh Khang, Star Arena xin cảm ơn góp ý của anh. Chúng tôi sẽ kiểm tra và xử lý sớm."
        android:textColor="@color/owner_text_title"
        android:textSize="13sp" />

    <!-- Nút Đăng phản hồi -->
    <Button
        android:id="@+id/btnSubmitReplyReview"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_owner_add_btn"
        android:text="Đăng phản hồi"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
