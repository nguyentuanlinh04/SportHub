<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainPasswordChangedSuccess"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    tools:context=".PasswordChangedSuccessActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="24dp">

        <!-- Top Header Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="Back Button"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Khôi phục tài khoản"
            android:textColor="@color/text_title"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Khôi phục tài khoản" />

        <!-- Success Circle Checkmark Container -->
        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_success_circle">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="Success Check"
                android:src="@drawable/ic_checkmark_green" />
        </FrameLayout>

        <!-- Header Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Đổi mật khẩu thành công"
            android:textColor="@color/text_title"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Đổi mật khẩu thành công" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Mật khẩu mới đã được lưu. Bạn có thể đăng nhập lại để tiếp tục đặt sân."
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            tools:text="Mật khẩu mới đã được lưu. Bạn có thể đăng nhập lại để tiếp tục đặt sân." />

        <!-- Account Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_pitch"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Tài khoản"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Tài khoản" />

                <TextView
                    android:id="@+id/tvAccountName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Minh"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Minh" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Số điện thoại"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Số điện thoại" />

                <TextView
                    android:id="@+id/tvAccountPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="+84 912 345 678"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="+84 912 345 678" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Main Button: Quay lại đăng nhập -->
        <TextView
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_action_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Quay lại đăng nhập"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Quay lại đăng nhập" />

        <!-- Notice Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_checkbox_checked"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập bằng mật khẩu mới"
                android:textColor="#0A6A3A"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Đăng nhập bằng mật khẩu mới" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Dùng số điện thoại và mật khẩu vừa tạo. Mật khẩu cũ không còn hiệu lực."
                android:textColor="#374151"
                android:textSize="12sp"
                tools:text="Dùng số điện thoại và mật khẩu vừa tạo. Mật khẩu cũ không còn hiệu lực." />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
