<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainPaymentFailed"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    tools:context=".PaymentFailedActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="24dp">

        <!-- Top Bar Header (Back & Title) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back Button"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Kết quả thanh toán"
                android:textColor="@color/text_title"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Kết quả thanh toán" />
        </LinearLayout>

        <!-- Failed Icon Container -->
        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_failed_circle">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="Failed Icon"
                android:src="@drawable/ic_cross_red" />
        </FrameLayout>

        <!-- Status Header Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Thanh toán không thành công"
            android:textColor="@color/text_title"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Thanh toán không thành công" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Chưa nhận được xác nhận từ cổng thanh toán. Đơn chưa được xác nhận đặt sân."
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            tools:text="Chưa nhận được xác nhận từ cổng thanh toán. Đơn chưa được xác nhận đặt sân." />

        <!-- Order Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_pitch"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvPitchSubPitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cụm sân Thắng Long · Sân 5-A"
                android:textColor="@color/text_title"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Cụm sân Thắng Long · Sân 5-A" />

            <TextView
                android:id="@+id/tvOrderCodeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="SH-1109-0187 · Minh"
                android:textColor="@color/text_sub"
                android:textSize="13sp"
                tools:text="SH-1109-0187 · Minh" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="#EAEFE9" />

            <TextView
                android:id="@+id/tvFullDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thứ 2, 09/11/2026 · 18:00–20:00"
                android:textColor="@color/text_title"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Thứ 2, 09/11/2026 · 18:00–20:00" />
        </LinearLayout>

        <!-- Deposit & Remaining Reservation Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_pitch"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Tiền cọc"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Tiền cọc" />

                <TextView
                    android:id="@+id/tvDepositAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="255.000đ"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="255.000đ" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="Giữ chỗ còn lại"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="Giữ chỗ còn lại" />

                <TextView
                    android:id="@+id/tvRemainingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="04:32"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="04:32" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Warning Notice Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_notice_warning"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nếu tài khoản có biến động số dư"
                android:textColor="#8F5300"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Nếu tài khoản có biến động số dư" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Kiểm tra giao dịch trước khi thử lại hoặc liên hệ hỗ trợ kèm mã đơn. Chưa có kết luận tiền đã bị trừ."
                android:textColor="#A06200"
                android:textSize="12sp"
                tools:text="Kiểm tra giao dịch trước khi thử lại hoặc liên hệ hỗ trợ kèm mã đơn. Chưa có kết luận tiền đã bị trừ." />
        </LinearLayout>

        <!-- Main Button 1: Kiểm tra & thử lại -->
        <TextView
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_action_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Kiểm tra &amp; thử lại"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Kiểm tra &amp; thử lại" />

        <!-- Secondary Button 2: Đổi phương thức thanh toán -->
        <TextView
            android:id="@+id/btnChangeMethod"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_edit_profile"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Đổi phương thức thanh toán"
            android:textColor="@color/primary_green"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Đổi phương thức thanh toán" />

        <!-- Action Link 3: Xem chi tiết đơn -->
        <TextView
            android:id="@+id/btnViewOrderDetails"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Xem chi tiết đơn"
            android:textColor="@color/primary_green"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Xem chi tiết đơn" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
