<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardStaffRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_owner_white_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvStaffAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar_circle_lime"
            android:gravity="center"
            android:text="Na"
            android:textColor="#166534"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStaffName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lê Hoàng Nam"
                android:textColor="@color/owner_text_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStaffRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Quản lý ca sáng"
                android:textColor="@color/owner_text_sub"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStaffStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_owner_status_active"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Hoạt động"
            android:textColor="@color/owner_status_active_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="#F1F5F9" />

    <!-- Thông tin Đăng nhập & Xem doanh thu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đăng nhập"
            android:textColor="@color/owner_text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStaffPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0933 555 789"
            android:textColor="@color/owner_text_title"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mật khẩu"
            android:textColor="@color/owner_text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnStaffChangePass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="•••••••• (Đổi MK)"
            android:textColor="@color/owner_green_btn"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xem doanh thu"
            android:textColor="@color/owner_text_sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStaffRevenueStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đã ẩn"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3 Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnStaffPerm"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_staff_action_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Phân quyền"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStaffLock"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_staff_action_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Khóa"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnStaffDelete"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_staff_revoke_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Thu hồi"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
