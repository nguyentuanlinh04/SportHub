<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tạo lịch sân mới"
                android:textColor="@color/owner_text_title"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Thêm lịch đặt trực tiếp hoặc đặt toàn sân"
                android:textColor="@color/owner_text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseCreateSchedule"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/owner_text_sub"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Hàng 2 cột: Sân đặt & Khung giờ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <!-- Chọn Sân -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sân đặt *"
                android:textColor="@color/owner_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutSchedulePitch"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_owner_search_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <TextView
                    android:id="@+id/tvSchedulePitch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sân 5-A"
                    android:textColor="@color/owner_text_title"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/owner_text_sub" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chọn Khung giờ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khung giờ đá *"
                android:textColor="@color/owner_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutScheduleTime"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_owner_search_input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <TextView
                    android:id="@+id/tvScheduleTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="18:00 - 19:30"
                    android:textColor="@color/owner_text_title"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/owner_text_sub" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Hình thức đặt -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Hình thức đặt"
        android:textColor="@color/owner_text_title"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chipTypeSingle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_slot_custom_single"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Đặt lẻ"
            android:textColor="#334155"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipTypeFixed"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tag_pitch_blue"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Cố định"
            android:textColor="#0369A1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipTypeFull"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_card_pitch_maintenance"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Toàn sân 11"
            android:textColor="#B45309"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tên đội bóng / Khách hàng -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tên đội bóng / Khách hàng *"
        android:textColor="@color/owner_text_title"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtScheduleTeam"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_owner_search_input"
        android:hint="VD: FC Bão Táp"
        android:paddingHorizontal="12dp"
        android:textColor="@color/owner_text_title"
        android:textSize="13sp" />

    <!-- SĐT & Tiền cọc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số điện thoại *"
                android:textColor="@color/owner_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtSchedulePhone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_owner_search_input"
                android:hint="09xx xxx xxx"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textColor="@color/owner_text_title"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiền cọc / Tiền sân"
                android:textColor="@color/owner_text_title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtScheduleFee"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_owner_search_input"
                android:hint="310.000đ"
                android:paddingHorizontal="12dp"
                android:textColor="@color/owner_text_title"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Nút Xác nhận tạo lịch sân -->
    <Button
        android:id="@+id/btnSubmitCreateSchedule"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_owner_add_btn"
        android:text="Xác nhận tạo lịch sân"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
