<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainSelectLocation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    tools:context=".SelectLocationActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Top Bar Header (Back & Title) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back Button"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Chọn khu vực"
                android:textColor="@color/text_title"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Chọn khu vực" />
        </LinearLayout>

        <!-- Search Input Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Tìm địa chỉ hoặc khu vực"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Tìm địa chỉ hoặc khu vực" />

        <EditText
            android:id="@+id/edtLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_search_input"
            android:hint="Nhập vị trí của bạn..."
            android:imeOptions="actionDone"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:text="Cầu Giấy, Hà Nội"
            android:textColor="@color/text_title"
            android:textColorHint="#9CA3AF"
            android:textSize="15sp" />

        <!-- Current Location Card -->
        <RelativeLayout
            android:id="@+id/rlUseCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_pitch"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/ivLocationTarget"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Target Icon"
                android:src="@drawable/ic_location_target" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/ivLocationTarget"
                android:text="Dùng vị trí hiện tại"
                android:textColor="@color/text_title"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Dùng vị trí hiện tại" />
        </RelativeLayout>

        <!-- Warning Notice Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_notice_warning"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có quyền truy cập vị trí"
                android:textColor="#8F5300"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Chưa có quyền truy cập vị trí" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bạn vẫn có thể nhập địa chỉ hoặc chọn khu vực bên dưới để tìm sân."
                android:textColor="#A06200"
                android:textSize="12sp"
                tools:text="Bạn vẫn có thể nhập địa chỉ hoặc chọn khu vực bên dưới để tìm sân." />
        </LinearLayout>

        <!-- District List Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="Chọn thủ công · Hà Nội"
            android:textColor="@color/text_title"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Chọn thủ công · Hà Nội" />

        <!-- District List Container Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_pitch"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDistricts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="5"
                tools:listitem="@layout/item_district" />
        </LinearLayout>

        <!-- Bottom Apply Button -->
        <TextView
            android:id="@+id/btnApplyLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_btn_action_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Áp dụng Cầu Giấy, Hà Nội"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Áp dụng Cầu Giấy, Hà Nội" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
