<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainPitchDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    tools:context=".PitchDetailActivity">

    <!-- Scrollable Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Image Banner Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="@drawable/bg_pitch_field_hero">

                <!-- Top Floating Action Buttons (Back & Favorite) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="52dp">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_circle_btn"
                        android:contentDescription="Back Button"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_back" />

                    <ImageButton
                        android:id="@+id/btnFavorite"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_circle_btn"
                        android:contentDescription="Favorite Button"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_heart_outline" />
                </RelativeLayout>

                <!-- Photo Count Badge -->
                <TextView
                    android:id="@+id/tvPhotoCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="36dp"
                    android:background="@drawable/bg_photo_count"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="1 / 12 ảnh"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    tools:text="1 / 12 ảnh" />
            </FrameLayout>

            <!-- Overlapping Content Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_pitch_detail_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- Pitch Title -->
                <TextView
                    android:id="@+id/tvDetailPitchName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cụm sân Thắng Long"
                    android:textColor="@color/text_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Cụm sân Thắng Long" />

                <!-- Rating & Operating Hours Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="Star Icon"
                        android:src="@drawable/ic_star" />

                    <TextView
                        android:id="@+id/tvDetailRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="4,8 (126 đánh giá)"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="4,8 (126 đánh giá)" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="·   Mở cửa 05:30 – 23:00"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="·   Mở cửa 05:30 – 23:00" />
                </LinearLayout>

                <!-- Address & Directions Card -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_pitch"
                    android:padding="12dp">

                    <FrameLayout
                        android:id="@+id/flMapBox"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_map_box">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="Location Pin"
                            android:src="@drawable/ic_location_pin" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="10dp"
                        android:layout_toEndOf="@id/flMapBox"
                        android:layout_toStartOf="@id/btnDirections"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDetailAddress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 Trần Thái Tông, Cầu Giấy, Hà Nội"
                            android:textColor="@color/text_title"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="12 Trần Thái Tông, Cầu Giấy, Hà Nội" />

                        <TextView
                            android:id="@+id/tvDetailDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Cách bạn 0,8 km"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp"
                            tools:text="Cách bạn 0,8 km" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnDirections"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_btn_direction"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Chỉ đường"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Chỉ đường" />
                </RelativeLayout>

                <!-- Section: Tiện ích -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="Tiện ích"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Tiện ích" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Amenity 1: Bãi đỗ xe -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_pitch"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Bãi đỗ xe"
                            android:src="@drawable/ic_amenity_p" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Bãi đỗ xe"
                            android:textColor="@color/text_title"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="Bãi đỗ xe" />
                    </LinearLayout>

                    <!-- Amenity 2: Căn tin -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_pitch"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Căn tin"
                            android:src="@drawable/ic_amenity_canteen" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Căn tin"
                            android:textColor="@color/text_title"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="Căn tin" />
                    </LinearLayout>

                    <!-- Amenity 3: Phòng thay đồ -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_pitch"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Phòng thay đồ"
                            android:src="@drawable/ic_amenity_dressing" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Phòng thay đồ"
                            android:textColor="@color/text_title"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="Phòng thay đồ" />
                    </LinearLayout>

                    <!-- Amenity 4: Đèn LED -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="90dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_pitch"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="Đèn LED"
                            android:src="@drawable/ic_amenity_bulb" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Đèn LED"
                            android:textColor="@color/text_title"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="Đèn LED" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Section: Các sân trong cụm -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="Các sân trong cụm"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Các sân trong cụm" />

                <!-- Sub-pitch 1 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_pitch"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sân 5-A"
                            android:textColor="@color/text_title"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Sân 5-A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Cỏ nhân tạo · 5 người"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp"
                            tools:text="Cỏ nhân tạo · 5 người" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="250.000đ/giờ"
                        android:textColor="@color/primary_green"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="250.000đ/giờ" />
                </RelativeLayout>

                <!-- Sub-pitch 2 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_pitch"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sân 7-1"
                            android:textColor="@color/text_title"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Sân 7-1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Cỏ nhân tạo · 7 người"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp"
                            tools:text="Cỏ nhân tạo · 7 người" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="400.000đ/giờ"
                        android:textColor="@color/primary_green"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="400.000đ/giờ" />
                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action Bar (Price & Choose Booking Time Button) -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá từ"
                android:textColor="@color/text_sub"
                android:textSize="12sp"
                tools:text="Giá từ" />

            <TextView
                android:id="@+id/tvDetailBottomPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="250.000đ"
                android:textColor="@color/primary_green"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="250.000đ" />
        </LinearLayout>

        <!-- Main Button: Chọn giờ đặt sân -->
        <TextView
            android:id="@+id/btnSelectBookingTime"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:background="@drawable/bg_btn_action_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="Chọn giờ đặt sân"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Chọn giờ đặt sân" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
