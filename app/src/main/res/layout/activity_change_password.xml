<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainChangePassword"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    tools:context=".ChangePasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="24dp">

        <!-- Top Header Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_btn"
            android:contentDescription="Back Button"
            android:padding="8dp"
            android:src="@drawable/ic_back" />

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Đặt mật khẩu mới"
            android:textColor="@color/text_title"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Đặt mật khẩu mới" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Số điện thoại +84 912 345 678 đã được xác thực bằng OTP."
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            tools:text="Số điện thoại +84 912 345 678 đã được xác thực bằng OTP." />

        <!-- Verified Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_skill_badge_green"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Đã xác thực SĐT"
            android:textColor="#0A6A3A"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Đã xác thực SĐT" />

        <!-- Input 1: Mật khẩu mới -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp"
            android:text="Mật khẩu mới"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Mật khẩu mới" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_card_pitch"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/ivToggleNewPassword"
                android:background="@null"
                android:hint="••••••••••"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textColor="@color/text_title"
                android:textColorHint="#9CA3AF"
                android:textSize="16sp"
                tools:text="••••••••••" />

            <ImageView
                android:id="@+id/ivToggleNewPassword"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="Toggle Password"
                android:focusable="true"
                android:src="@drawable/ic_eye_slash" />
        </RelativeLayout>

        <!-- Input 2: Xác nhận mật khẩu mới -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="Xác nhận mật khẩu mới"
            android:textColor="@color/text_title"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Xác nhận mật khẩu mới" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_card_pitch"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/ivToggleConfirmPassword"
                android:background="@null"
                android:hint="••••••••••"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:textColor="@color/text_title"
                android:textColorHint="#9CA3AF"
                android:textSize="16sp"
                tools:text="••••••••••" />

            <ImageView
                android:id="@+id/ivToggleConfirmPassword"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:contentDescription="Toggle Confirm Password"
                android:focusable="true"
                android:src="@drawable/ic_eye_slash" />
        </RelativeLayout>

        <!-- Password Validation Checklist Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_checkbox_checked"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Mật khẩu đủ an toàn"
                android:textColor="@color/text_title"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Mật khẩu đủ an toàn" />

            <!-- Item 1: Ít nhất 8 ký tự -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCheckMinLength"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Check Icon"
                    android:src="@drawable/ic_check_small_green" />

                <TextView
                    android:id="@+id/tvCheckMinLength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Ít nhất 8 ký tự"
                    android:textColor="#374151"
                    android:textSize="13sp"
                    tools:text="Ít nhất 8 ký tự" />
            </LinearLayout>

            <!-- Item 2: Có chữ hoa và chữ thường -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCheckUpperLower"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Check Icon"
                    android:src="@drawable/ic_check_small_green" />

                <TextView
                    android:id="@+id/tvCheckUpperLower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Có chữ hoa và chữ thường"
                    android:textColor="#374151"
                    android:textSize="13sp"
                    tools:text="Có chữ hoa và chữ thường" />
            </LinearLayout>

            <!-- Item 3: Có ít nhất một chữ số -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCheckDigit"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Check Icon"
                    android:src="@drawable/ic_check_small_green" />

                <TextView
                    android:id="@+id/tvCheckDigit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Có ít nhất một chữ số"
                    android:textColor="#374151"
                    android:textSize="13sp"
                    tools:text="Có ít nhất một chữ số" />
            </LinearLayout>

            <!-- Item 4: Hai mật khẩu trùng khớp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivCheckMatch"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Check Icon"
                    android:src="@drawable/ic_check_small_green" />

                <TextView
                    android:id="@+id/tvCheckMatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Hai mật khẩu trùng khớp"
                    android:textColor="#374151"
                    android:textSize="13sp"
                    tools:text="Hai mật khẩu trùng khớp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Button: Lưu mật khẩu mới -->
        <TextView
            android:id="@+id/btnSavePassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_btn_action_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Lưu mật khẩu mới"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Lưu mật khẩu mới" />

        <!-- Secondary Link: Quay về đăng nhập -->
        <TextView
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Quay về đăng nhập"
            android:textColor="@color/primary_green"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Quay về đăng nhập" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
