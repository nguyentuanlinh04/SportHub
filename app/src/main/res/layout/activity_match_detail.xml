<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainMatchDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    tools:context=".MatchDetailActivity">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomActionBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="52dp"
            android:paddingBottom="24dp">

            <!-- Top Header Bar (Back & Title) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back Button"
                    android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Chi tiết kèo giao hữu"
                    android:textColor="@color/text_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Chi tiết kèo giao hữu" />
            </LinearLayout>

            <!-- Team Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_pitch"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Avatar Badge -->
                    <TextView
                        android:id="@+id/tvDetailTeamAvatar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_team_avatar_green"
                        android:gravity="center"
                        android:text="FC"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="FC" />

                    <!-- Team Name & Subtitle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDetailTeamName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FC Cầu Giấy United"
                            android:textColor="@color/text_title"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="FC Cầu Giấy United" />

                        <TextView
                            android:id="@+id/tvDetailCaptainDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Đội trưởng: Hoàng Nam · Cách bạn 1,2 km"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp"
                            tools:text="Đội trưởng: Hoàng Nam · Cách bạn 1,2 km" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Badges Row (Đang tìm đối + Trình độ Khá) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_skill_badge_green"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Đang tìm đối"
                        android:textColor="#0A6A3A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Đang tìm đối" />

                    <TextView
                        android:id="@+id/tvSkillBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_skill_badge_orange"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Trình độ Khá"
                        android:textColor="#8F5300"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Trình độ Khá" />
                </LinearLayout>

            </LinearLayout>

            <!-- Match Details Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_pitch"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="Thông tin trận đấu"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Thông tin trận đấu" />

                <!-- Table Rows -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Ngày đá"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="Ngày đá" />

                    <TextView
                        android:id="@+id/tvDetailDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="T4, 11/11/2026"
                        android:textColor="@color/text_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="T4, 11/11/2026" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Thời gian"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="Thời gian" />

                    <TextView
                        android:id="@+id/tvDetailTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="19:00–20:00"
                        android:textColor="@color/text_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="19:00–20:00" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Loại sân"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="Loại sân" />

                    <TextView
                        android:id="@+id/tvDetailPitchType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Sân 7"
                        android:textColor="@color/text_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Sân 7" />
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="Chia tiền sân"
                        android:textColor="@color/text_sub"
                        android:textSize="13sp"
                        tools:text="Chia tiền sân" />

                    <TextView
                        android:id="@+id/tvDetailSplitFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="50 / 50"
                        android:textColor="@color/primary_green"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="50 / 50" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#EAEFE9" />

                <!-- Location Header & Address -->
                <TextView
                    android:id="@+id/tvDetailLocationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cụm sân Thắng Long · Sân 7-1"
                    android:textColor="@color/text_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Cụm sân Thắng Long · Sân 7-1" />

                <TextView
                    android:id="@+id/tvDetailLocationAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="12 Trần Thái Tông, Cầu Giấy, Hà Nội"
                    android:textColor="@color/text_sub"
                    android:textSize="13sp"
                    tools:text="12 Trần Thái Tông, Cầu Giấy, Hà Nội" />
            </LinearLayout>

            <!-- Note Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_pitch"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Ghi chú"
                    android:textColor="@color/text_title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Ghi chú" />

                <TextView
                    android:id="@+id/tvDetailNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đá giao hữu vui vẻ, đúng giờ. Hai đội trình độ Khá, chia đôi tiền sân."
                    android:textColor="#374151"
                    android:textSize="14sp"
                    tools:text="Đá giao hữu vui vẻ, đúng giờ. Hai đội trình độ Khá, chia đôi tiền sân." />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btnAcceptMatch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_btn_action_green"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Nhận kèo"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Nhận kèo" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
