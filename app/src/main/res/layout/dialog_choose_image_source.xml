<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvImageSourceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thêm hình ảnh"
        android:textColor="@color/owner_text_title"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Chọn phương thức tải ảnh lên cơ sở của bạn"
        android:textColor="@color/owner_text_sub"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="14dp"
        android:background="#F1F5F9" />

    <!-- Option 1: Chụp ảnh mới từ máy ảnh -->
    <LinearLayout
        android:id="@+id/btnOptionCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_owner_search_input"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_square_add"
            android:gravity="center"
            android:text="📸"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chụp ảnh mới"
                android:textColor="@color/owner_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mở máy ảnh thiết bị để chụp trực tiếp"
                android:textColor="@color/owner_text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/owner_text_sub"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Option 2: Chọn từ thư viện ảnh máy -->
    <LinearLayout
        android:id="@+id/btnOptionGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_owner_search_input"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_owner_status_active"
            android:gravity="center"
            android:text="🖼️"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn ảnh từ máy"
                android:textColor="@color/owner_text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Chọn ảnh có sẵn từ bộ sưu tập / tệp tin"
                android:textColor="@color/owner_text_sub"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/owner_text_sub"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cancel button -->
    <Button
        android:id="@+id/btnCancelImageSource"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_staff_action_btn"
        android:text="Hủy"
        android:textAllCaps="false"
        android:textColor="@color/owner_text_sub"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
